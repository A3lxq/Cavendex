# Preferred free option
GROQ_API_KEY=gsk_your_groq_key_here

# Fallback
OPENAI_API_KEY=sk-your_openai_key_here

# Optional
ANTHROPIC_API_KEY=

# Optional — Google AI Studio (Gemini)
GOOGLE_API_KEY=

# Optional — local models via Ollama (no API key required)
# Set OLLAMA_MODEL to a model you've pulled, e.g. `ollama pull llama3.1`
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Base directory for checkpointed incident state (SQLite) — each tenant
# gets its own subfolder: {CAVENDEX_DATA_DIR}/{tenant_id}/cavendex.db
CAVENDEX_DATA_DIR=data

# Base directory for long-term incident memory (ChromaDB) — each tenant
# gets its own subfolder/collection
CHROMA_PERSIST_DIR=.chroma

# Base directory for the Obsidian vault of incident/hunt reports — each
# tenant gets its own subfolder: {OBSIDIAN_VAULT_PATH}/{tenant_id}/
OBSIDIAN_VAULT_PATH=obsidian_vault

# Optional — require `Authorization: Bearer <key>` on every API route
# except /health. Unset: the API runs unauthenticated (local/dev only).
# This one key alone authorizes the unprefixed (default-tenant) routes,
# and any /tenants/{tenant_id}/... route that has no entry in
# CAVENDEX_TENANT_API_KEYS below.
CAVENDEX_API_KEY=

# Optional — per-tenant API keys, as a JSON object mapping tenant_id to
# its own key, e.g. {"acme-corp": "key-for-acme", "globex": "key-for-globex"}.
# Without this, CAVENDEX_API_KEY alone authorizes a caller for EVERY
# tenant — fine if one trusted operator uses tenants just to organize
# data, but not a real boundary between organizations that shouldn't see
# each other's incidents. A tenant listed here only ever accepts its own
# key on its /tenants/{tenant_id}/... routes; the global key no longer
# works for it. A tenant NOT listed here keeps falling back to the
# global key, so adding this is opt-in and never breaks an existing
# single-key deployment.
CAVENDEX_TENANT_API_KEYS=

# Optional — reject an approve/deny call that doesn't include an analyst
# name (CLI --by, the API's approved_by field, or the dashboard's
# Analyst name field). Without this, the dashboard's "enter your name"
# requirement is enforced client-side only (a JS alert()) — anyone
# calling the API directly can still approve/deny with no name at all,
# recorded honestly as "unspecified" rather than blocked. Set to make
# attribution mandatory, not just encouraged. Off by default so existing
# automation that doesn't pass a name keeps working.
CAVENDEX_REQUIRE_APPROVED_BY=false

# Optional — real per-tenant user accounts and dashboard login (see
# utils/user_accounts.py), on top of (never instead of) CAVENDEX_API_KEY
# above. Create the first user with `python cli.py create-user <username>
# <password> --role admin` (or POST /auth/users, open until a tenant's
# first user exists). Logging in via the dashboard's Sign In form issues
# a session used as the Authorization bearer credential in place of the
# API key, and auto-fills approved_by with the real username instead of
# a freely-typed label. Creating a user never by itself locks out
# unauthenticated callers -- see CAVENDEX_REQUIRE_LOGIN below for that.
CAVENDEX_PASSWORD_HASH_ITERATIONS=600000
CAVENDEX_SESSION_TTL_SECONDS=28800
# Tighter than the API's own rate limits, since this is the one route
# whose entire job is checking a password against a stored hash.
CAVENDEX_LOGIN_RATE_LIMIT_PER_MINUTE=5
# Opt-in: once true, a tenant with any real user account requires a
# valid credential (a session OR the API key) for every request, even if
# CAVENDEX_API_KEY was never set. Off by default so creating a user
# purely for its accountability benefit (real approved_by attribution)
# never silently changes who can otherwise reach an open tenant.
CAVENDEX_REQUIRE_LOGIN=false

# Optional — alert (via the webhook above) when repeated failed API key
# attempts from the same source cross a threshold within a time window,
# logged either way to data/auth_failures.jsonl. Set the threshold to 0
# to disable alerting while still logging every failure.
CAVENDEX_AUTH_FAILURE_ALERT_THRESHOLD=5
CAVENDEX_AUTH_FAILURE_WINDOW_SECONDS=300

# Optional — makes rate limiting AND dedup (both below) genuinely
# distributed across multiple uvicorn workers/replicas instead of each
# process keeping its own private, in-memory copy. Unset (the default):
# both are in-process only, correct for a single-process deployment. Set
# this and both switch to a real Redis-backed sliding-window
# implementation with identical semantics — see README's "Distributed
# Rate Limiting and Dedup" and DEPLOYMENT.md's "Run it as a service".
# Does NOT affect correlation, which already reads from a durable SQLite
# file shared across workers on one host and was never in-memory state.
CAVENDEX_REDIS_URL=

# Max incident/hunt creation requests per client per minute on the API
# (each one runs a full LLM pipeline). Set to 0 to disable.
CAVENDEX_RATE_LIMIT_PER_MINUTE=10

# Max ingested alerts per tenant per minute — enforced INSIDE the shared
# ingestion gate itself (ingestion/pipeline.py), not just at the API
# layer. This is what protects syslog_listener.py and poll_connector.py,
# which call into ingestion directly and never touch the API's own rate
# limiting above. Higher than CAVENDEX_RATE_LIMIT_PER_MINUTE by default
# since real detection-tool alert volume is expected to be higher than
# manual/API-driven incident creation. Set to 0 to disable.
CAVENDEX_INGEST_RATE_LIMIT_PER_MINUTE=60

# Ingestion (see ingestion/): the minimum normalized severity that gets
# promoted to a full agent pipeline run; anything below is logged to
# data/{tenant}/ingestion_log.jsonl but doesn't spend an LLM call.
CAVENDEX_INGEST_MIN_SEVERITY=medium

# Ingestion dedup window — repeat alerts sharing the same (tenant,
# dedup_key) within this many seconds are deduped, not re-promoted.
# Set to 0 to disable.
CAVENDEX_DEDUP_WINDOW_SECONDS=300

# Correlation window (see ingestion/correlation.py) — a new alert that
# shares an IOC or affected asset with an already-open incident updated
# within this many seconds is merged into that incident instead of
# starting a new one (bypassing CAVENDEX_INGEST_MIN_SEVERITY, since
# it's evidence for something already flagged). Set to 0 to disable.
CAVENDEX_CORRELATION_WINDOW_SECONDS=3600

# Fuzzy correlation (only used when the exact tier above finds nothing):
# groups a new alert into an open incident whose IOCs include an IP in
# the same subnet, or a domain sharing the same registered/apex domain.
# Set the fuzzy flag to false to correlate on exact IOC/asset overlap
# only.
#
# The two prefix-bits values are the subnet size to group by for each
# address family, independently — real networks aren't all /24s, so pick
# whatever size actually matches how your environment is subnetted (see
# README's "IP Ranges and Subnet Support" for real-world sizing guidance
# and a worked example — a flat /16 office network wants a much smaller
# number here than a /27 branch office does). Accepts any valid CIDR
# length: 1-32 for IPv4, 1-128 for IPv6 (both independently configurable
# — IPv6 used to be hardcoded to /64 with no way to change it).
CAVENDEX_CORRELATION_FUZZY_ENABLED=true
CAVENDEX_CORRELATION_SUBNET_PREFIX_BITS=24
CAVENDEX_CORRELATION_SUBNET_PREFIX_BITS_V6=64

# Identity correlation (see ingestion/identity_correlation.py) — a fourth
# free, deterministic tier, checked right alongside exact/fuzzy above
# (before CAVENDEX_INGEST_MIN_SEVERITY), for the case neither exact nor
# fuzzy can catch: a renamed asset, or a lexically-unrelated second-stage
# domain. Two independent signals, each opt-in by simply being
# unconfigured:
#
# - Asset identity: point this at a small JSON file exported from your
#   real inventory/CMDB, mapping any alias you track (old hostname,
#   serial number, whatever) to one canonical ID — e.g.
#   {"WEB-01": "asset-042", "WEB-01-RENAMED": "asset-042"}. Reloaded
#   whenever the file's mtime changes, no restart needed. Exact-string
#   lookup only — see utils/asset_inventory.py for why a fuzzy match here
#   would reintroduce the guesswork this feature exists to replace.
CAVENDEX_ASSET_INVENTORY_PATH=
# - Domain identity: real passive DNS via VirusTotal's domain-resolutions
#   endpoint — two lexically-unrelated domains that have both resolved to
#   the same IP are plausibly the same C2 infrastructure at a different
#   stage. Requires VIRUSTOTAL_API_KEY (below) and is off by default even
#   when a key is present: unlike the asset signal, this spends a real
#   rate-limited API call on every alert with a domain IOC, on top of
#   whatever enrichment already spends checking that same domain's
#   reputation.
CAVENDEX_CORRELATION_IDENTITY_DNS_ENABLED=false

# Semantic correlation (see ingestion/semantic_correlation.py) — a third,
# opt-in tier that spends one real LLM call to judge whether an alert
# belongs to the same campaign as an open incident despite sharing no
# IOC, subnet, or domain family at all (e.g. the same attack technique
# against a completely different host). Off by default: unlike the free
# exact/fuzzy tiers, this one costs tokens and carries real judgment-call
# risk. It only ever runs for an alert that already passed
# CAVENDEX_INGEST_MIN_SEVERITY (i.e. one about to spend a full,
# far more expensive pipeline run anyway) — a match replaces that cost,
# it never adds a new one to routine noise that would've been suppressed.
CAVENDEX_CORRELATION_SEMANTIC_ENABLED=false
# How many of the most-recently-updated open incidents to show the judge
# per check — bounds prompt size/cost regardless of how many are open.
CAVENDEX_CORRELATION_SEMANTIC_MAX_CANDIDATES=5
# Minimum confidence (low/medium/high) the judge must report before a
# semantic match is trusted; anything below is treated as no match.
CAVENDEX_CORRELATION_SEMANTIC_MIN_CONFIDENCE=medium

# Optional — Splunk polling connector (see poll_connector.py +
# examples/splunk_poller_config.example.json). Splunk's own token-auth
# feature issues a long-lived bearer token — the config file's
# auth_token_env can name any variable, but the shipped example config
# names this one specifically.
SPLUNK_API_TOKEN=

# Optional — CrowdStrike Falcon polling connector (see
# crowdstrike_connector.py + ingestion/crowdstrike_polling.py). Falcon
# uses OAuth2 client-credentials, not a static token — create an API
# client in the Falcon console (Support and resources > API clients and
# keys) with the "Detections: Read" scope.
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=

# Optional — threat-intel enrichment (see enrichment/). Without these,
# Triage still runs, just without verified IOC reputation data; the
# ATT&CK technique validation (enrichment/mitre_attack.py) needs no key
# at all, since it's a local curated dataset, not a live API.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Shodan exposed-service enrichment (see enrichment/providers.py) — needs
# NO API key at all, since it uses Shodan's free InternetDB endpoint
# (https://internetdb.shodan.io). It's gated by this flag instead of a
# key: querying a third party with an IP you're actively investigating is
# a real operational-security choice (it tells Shodan which IPs this
# deployment cares about), so it defaults to off rather than making that
# call silently just because it happens to be free. When enabled, every
# "ip" IOC also gets checked for exposed ports/hostnames/known CVEs.
CAVENDEX_SHODAN_ENABLED=false

# 8 more opt-in threat-intel providers (see enrichment/providers.py and
# README's "Adding a Threat-Intel Provider" for what each one actually
# adds beyond AbuseIPDB/VirusTotal/Shodan above). Every one is inert
# until its key is set, exactly like the ones above — configure only
# the ones you actually want.
#
# AlienVault OTX — community-curated campaign "Pulse" context (ip/domain/hash).
ALIENVAULT_OTX_API_KEY=
# GreyNoise — internet-wide scan-noise vs. targeted-probe classification
# (ip only). Free "Community" registration requires a business email.
GREYNOISE_API_KEY=
# MalwareBazaar + ThreatFox + URLhaus (all abuse.ch) — one registration
# at auth.abuse.ch issues a single Auth-Key covering all three.
# MalwareBazaar: named malware family/signature (hash). ThreatFox: named
# family + confidence score (ip/domain/hash/url). URLhaus: known
# malware-distribution URLs + payload type (url).
ABUSECH_API_KEY=
# IBM X-Force Exchange — CVE-linked risk scoring, named threat-actor
# Collections (ip/hash/url). BOTH vars are required (HTTP Basic Auth).
# Honest caveat: this integration's continued standalone API
# availability was genuinely unconfirmed at research time — a live 2026
# end-of-life notice tied to the Palo Alto Networks/QRadar transition,
# scope unclear. Confirm directly with IBM before relying on this.
IBM_XFORCE_API_KEY=
IBM_XFORCE_API_PASSWORD=
# Metadefender Cloud (OPSWAT) — multi-engine aggregated detection
# verdict (ip/domain/hash/url). Honest caveat: response parsing here is
# built from public docs only, not a verified real successful response
# — the only concrete free-tier numbers found during research were from
# a 2018 blog post.
METADEFENDER_API_KEY=
# Censys — internet-exposed host/service data via a host lookup (ip
# only), complementary to Shodan. Honest caveat: free-tier limits were
# reported as unstable across sources at research time.
CENSYS_API_KEY=
#
# 9 more opt-in threat-intel providers, round 2 (see enrichment/providers.py
# and README's "Adding a Threat-Intel Provider"). Same rule as above:
# every one is inert until its key/flag is set.
#
# Pulsedive — community risk-tagging + named threat/campaign
# associations (ip/domain/url).
PULSEDIVE_API_KEY=
# ThreatMiner — free passive-DNS + related-malware-sample graph
# (ip/domain/hash). Needs NO API key, same as Shodan — gated by this
# flag instead for the same operational-security reason (querying a
# third party about an IOC under investigation shouldn't happen
# silently just because it's free). Honest caveat: this project's
# research found threatminer.org's own endpoint intermittently
# unreachable/erroring — it's not treated as a stable dependency, and
# degrades to an "error" verdict rather than blocking anything.
CAVENDEX_THREATMINER_ENABLED=false
# Hybrid Analysis (CrowdStrike Falcon Sandbox public service) — a real
# sandbox-behavior verdict/threat score for a hash (hash only), not just
# AV consensus. Read-only lookup of an already-analyzed sample — never
# uploads a file. Honest caveat: response field names come from public
# docs/third-party references, not a confirmed live successful response.
HYBRIDANALYSIS_API_KEY=
# Intezer — code-genetics/reuse-based verdict for a hash (hash only), a
# fundamentally different detection method than AV consensus. Same
# honest caveat as Hybrid Analysis above.
INTEZER_API_KEY=
# urlscan.io — real prior-scan history (screenshots, DOM/JS behavior)
# for a domain/URL. Deliberately always returns an "unknown" verdict:
# confirmed against real docs to expose scan metadata only, no
# malicious/clean flag — the real value is in the detail text and link.
URLSCAN_API_KEY=
# Google Safe Browsing (Lookup API v4) — Google's own browser-blocklist
# signal (domain/url; a bare domain is checked as its own root URL).
GOOGLE_SAFE_BROWSING_API_KEY=
# SecurityTrails — real current DNS records + subdomain count (domain
# only), an infrastructure fact-sheet rather than a reputation verdict;
# deliberately always returns "unknown" for the same reason as urlscan.io
# above. Free tier's exact monthly quota varied across sources at
# research time — verify at signup before relying on it for volume.
SECURITYTRAILS_API_KEY=
# Blocklist.de — free, keyless abuse-report-history check (ip only).
# Same keyless-provider pattern as Shodan/ThreatMiner above. Its
# response is plain text, not JSON, confirmed directly at research time
# ("attacks: N<br />reports: N<br />").
CAVENDEX_BLOCKLISTDE_ENABLED=false
# NVD (NIST) — CVSS severity/context for a CVE ID referenced in an
# incident (the ONLY provider here keyed on "cve" rather than
# ip/domain/hash/url). The underlying API needs no key at all, so this
# flag is the real gate, same keyless-provider pattern as above.
# NVD_API_KEY is optional and only raises the rate limit (5 req/30s
# unkeyed, 50/30s keyed) — it never gates whether this runs.
CAVENDEX_NVD_ENABLED=false
NVD_API_KEY=
#
# Bounds real outbound lookup *attempts* per incident (not just
# appended results) across every configured provider combined — a
# wider provider fan-out (up to 11 for one IP, after the round-2
# expansion above) is dispatched in parallel, and this cap keeps an
# alert with many fabricated-looking IOCs from turning that fan-out
# into an unbounded number of real third-party requests. Raised from 30
# to 50 when the provider count roughly doubled.
CAVENDEX_ENRICHMENT_MAX_LOOKUPS_PER_INCIDENT=50

# Alerting (see notifications/) — opt-in: unset, nothing is ever sent.
# Set to any URL that accepts a JSON POST and this fires a webhook
# notification whenever an incident reaches pending_approval (a human
# needs to act now) or its severity is at/above CAVENDEX_ALERT_MIN_SEVERITY
# (default "high"), regardless of status. Works natively with Slack,
# Discord, and Microsoft Teams incoming webhooks (they all render the
# payload's "text" field), PagerDuty's Events API, or your own relay —
# no vendor is hardcoded.
CAVENDEX_ALERT_WEBHOOK_URL=
CAVENDEX_ALERT_MIN_SEVERITY=high

# Optional — signs every outbound webhook POST with HMAC-SHA256, sent as
# the X-Cavendex-Signature header ("sha256=<hex>", the same shape
# GitHub/Stripe/Slack use for their own outbound webhooks). Without this,
# anyone who obtains the webhook URL can send your receiver a convincing
# fake notification and it has no way to tell. Additive — a receiver that
# doesn't check the header is unaffected either way.
CAVENDEX_WEBHOOK_SIGNING_SECRET=

# Optional — included as a clickable link in every notification payload
# if set (e.g. https://cavendex.internal.example.com). Omit it and
# notifications still work, just without a direct link back.
CAVENDEX_DASHBOARD_BASE_URL=

# Real, opt-in remediation execution behind the approval gate (see
# remediation/). Cavendex itself never runs a local command or calls
# one specific firewall/EDR vendor's API — an approved, automatable
# action (action_type block_ip/isolate_host by default; "other" is
# NEVER eligible regardless of this config) is POSTed to your own
# webhook, the same "no vendor hardcoded" principle as the alerting
# webhook above. Off by default (CAVENDEX_REMEDIATION_ENABLED=false):
# nothing here changes today's "propose only, human approves, done"
# behavior until you opt in.
CAVENDEX_REMEDIATION_ENABLED=false
# The literal sandbox: while true (the default whenever remediation is
# enabled at all), nothing is ever actually sent over the network —
# every eligible action is logged (audit log + a durable
# data/{tenant}/remediation_log.jsonl record) exactly as it would have
# been sent, so you can verify the wiring before flipping this to a
# real webhook call.
CAVENDEX_REMEDIATION_DRY_RUN=true
CAVENDEX_REMEDIATION_WEBHOOK_URL=
# Comma-separated action_type values eligible for automated execution —
# see state.py's ActionType for the full list. "other" is always
# excluded regardless of what's listed here.
CAVENDEX_REMEDIATION_ACTION_TYPES=block_ip,isolate_host
# Optional — HMAC-SHA256 signs the remediation request the same way
# CAVENDEX_WEBHOOK_SIGNING_SECRET signs alert notifications, as a
# separate secret since a remediation receiver is a more sensitive
# trust boundary and may reasonably be a different system entirely.
CAVENDEX_REMEDIATION_WEBHOOK_SIGNING_SECRET=

# Advanced playbooks (see playbooks/) — deterministic, non-LLM response
# templates: a match rule (severity/source/IOC-substring) plus an ordered
# list of remediation steps, evaluated once after an incident's agent
# pipeline finishes. Unset (the default): fully inert, zero cost, zero
# behavior change. Point this at a directory of *.json playbook files
# (one file per incident type is the intended shape, e.g.
# ransomware-response.json) — see README's "Advanced Playbooks" section
# for the file schema and a worked example. Use `python cli.py
# list-playbooks` to sanity-check what's currently loaded and why a file
# might have been skipped.
CAVENDEX_PLAYBOOKS_DIR=
# "append" (default) adds a matched playbook's steps alongside whatever
# the Responder Agent already proposed; "replace" uses only the
# playbook's steps instead.
CAVENDEX_PLAYBOOKS_MODE=append

# Rotation for the append-only JSONL logs (data/{tenant}/ingestion_log.jsonl,
# data/auth_failures.jsonl, data/{tenant}/audit_chain_ledger.jsonl,
# data/{tenant}/remediation_log.jsonl) — all grow forever without this.
# Rotates the active file to .1, a prior .1 to .2, etc. once it reaches
# CAVENDEX_LOG_MAX_BYTES, keeping at most CAVENDEX_LOG_BACKUP_COUNT
# old copies. Set MAX_BYTES to 0 to disable rotation entirely (unbounded
# growth); set BACKUP_COUNT to 0 to truncate instead of keeping any
# history.
CAVENDEX_LOG_MAX_BYTES=10485760
CAVENDEX_LOG_BACKUP_COUNT=3
