# Preferred free option
GROQ_API_KEY=gsk_your_groq_key_here

# Fallback
OPENAI_API_KEY=sk-your_openai_key_here

# Optional
ANTHROPIC_API_KEY=

# Optional — Google AI Studio (Gemini)
GOOGLE_API_KEY=

# Optional — local models via Ollama (no API key required)
# Set OLLAMA_MODEL to a model you've pulled, e.g. `ollama pull llama3.1`
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Base directory for checkpointed incident state (SQLite) — each tenant
# gets its own subfolder: {SENTINELOS_DATA_DIR}/{tenant_id}/sentinelos.db
SENTINELOS_DATA_DIR=data

# Base directory for long-term incident memory (ChromaDB) — each tenant
# gets its own subfolder/collection
CHROMA_PERSIST_DIR=.chroma

# Base directory for the Obsidian vault of incident/hunt reports — each
# tenant gets its own subfolder: {OBSIDIAN_VAULT_PATH}/{tenant_id}/
OBSIDIAN_VAULT_PATH=obsidian_vault

# Optional — require `Authorization: Bearer <key>` on every API route
# except /health. Unset: the API runs unauthenticated (local/dev only).
# This one key alone authorizes the unprefixed (default-tenant) routes,
# and any /tenants/{tenant_id}/... route that has no entry in
# SENTINELOS_TENANT_API_KEYS below.
SENTINELOS_API_KEY=

# Optional — per-tenant API keys, as a JSON object mapping tenant_id to
# its own key, e.g. {"acme-corp": "key-for-acme", "globex": "key-for-globex"}.
# Without this, SENTINELOS_API_KEY alone authorizes a caller for EVERY
# tenant — fine if one trusted operator uses tenants just to organize
# data, but not a real boundary between organizations that shouldn't see
# each other's incidents. A tenant listed here only ever accepts its own
# key on its /tenants/{tenant_id}/... routes; the global key no longer
# works for it. A tenant NOT listed here keeps falling back to the
# global key, so adding this is opt-in and never breaks an existing
# single-key deployment.
SENTINELOS_TENANT_API_KEYS=

# Optional — reject an approve/deny call that doesn't include an analyst
# name (CLI --by, the API's approved_by field, or the dashboard's
# Analyst name field). Without this, the dashboard's "enter your name"
# requirement is enforced client-side only (a JS alert()) — anyone
# calling the API directly can still approve/deny with no name at all,
# recorded honestly as "unspecified" rather than blocked. Set to make
# attribution mandatory, not just encouraged. Off by default so existing
# automation that doesn't pass a name keeps working.
SENTINELOS_REQUIRE_APPROVED_BY=false

# Optional — alert (via the webhook above) when repeated failed API key
# attempts from the same source cross a threshold within a time window,
# logged either way to data/auth_failures.jsonl. Set the threshold to 0
# to disable alerting while still logging every failure.
SENTINELOS_AUTH_FAILURE_ALERT_THRESHOLD=5
SENTINELOS_AUTH_FAILURE_WINDOW_SECONDS=300

# Max incident/hunt creation requests per client per minute on the API
# (each one runs a full LLM pipeline). Set to 0 to disable.
SENTINELOS_RATE_LIMIT_PER_MINUTE=10

# Max ingested alerts per tenant per minute — enforced INSIDE the shared
# ingestion gate itself (ingestion/pipeline.py), not just at the API
# layer. This is what protects syslog_listener.py and poll_connector.py,
# which call into ingestion directly and never touch the API's own rate
# limiting above. Higher than SENTINELOS_RATE_LIMIT_PER_MINUTE by default
# since real detection-tool alert volume is expected to be higher than
# manual/API-driven incident creation. Set to 0 to disable.
SENTINELOS_INGEST_RATE_LIMIT_PER_MINUTE=60

# Ingestion (see ingestion/): the minimum normalized severity that gets
# promoted to a full agent pipeline run; anything below is logged to
# data/{tenant}/ingestion_log.jsonl but doesn't spend an LLM call.
SENTINELOS_INGEST_MIN_SEVERITY=medium

# Ingestion dedup window — repeat alerts sharing the same (tenant,
# dedup_key) within this many seconds are deduped, not re-promoted.
# Set to 0 to disable.
SENTINELOS_DEDUP_WINDOW_SECONDS=300

# Correlation window (see ingestion/correlation.py) — a new alert that
# shares an IOC or affected asset with an already-open incident updated
# within this many seconds is merged into that incident instead of
# starting a new one (bypassing SENTINELOS_INGEST_MIN_SEVERITY, since
# it's evidence for something already flagged). Set to 0 to disable.
SENTINELOS_CORRELATION_WINDOW_SECONDS=3600

# Fuzzy correlation (only used when the exact tier above finds nothing):
# groups a new alert into an open incident whose IOCs include an IP in
# the same subnet, or a domain sharing the same registered/apex domain.
# Set the fuzzy flag to false to correlate on exact IOC/asset overlap
# only.
#
# The two prefix-bits values are the subnet size to group by for each
# address family, independently — real networks aren't all /24s, so pick
# whatever size actually matches how your environment is subnetted (see
# README's "IP Ranges and Subnet Support" for real-world sizing guidance
# and a worked example — a flat /16 office network wants a much smaller
# number here than a /27 branch office does). Accepts any valid CIDR
# length: 1-32 for IPv4, 1-128 for IPv6 (both independently configurable
# — IPv6 used to be hardcoded to /64 with no way to change it).
SENTINELOS_CORRELATION_FUZZY_ENABLED=true
SENTINELOS_CORRELATION_SUBNET_PREFIX_BITS=24
SENTINELOS_CORRELATION_SUBNET_PREFIX_BITS_V6=64

# Identity correlation (see ingestion/identity_correlation.py) — a fourth
# free, deterministic tier, checked right alongside exact/fuzzy above
# (before SENTINELOS_INGEST_MIN_SEVERITY), for the case neither exact nor
# fuzzy can catch: a renamed asset, or a lexically-unrelated second-stage
# domain. Two independent signals, each opt-in by simply being
# unconfigured:
#
# - Asset identity: point this at a small JSON file exported from your
#   real inventory/CMDB, mapping any alias you track (old hostname,
#   serial number, whatever) to one canonical ID — e.g.
#   {"WEB-01": "asset-042", "WEB-01-RENAMED": "asset-042"}. Reloaded
#   whenever the file's mtime changes, no restart needed. Exact-string
#   lookup only — see utils/asset_inventory.py for why a fuzzy match here
#   would reintroduce the guesswork this feature exists to replace.
SENTINELOS_ASSET_INVENTORY_PATH=
# - Domain identity: real passive DNS via VirusTotal's domain-resolutions
#   endpoint — two lexically-unrelated domains that have both resolved to
#   the same IP are plausibly the same C2 infrastructure at a different
#   stage. Requires VIRUSTOTAL_API_KEY (below) and is off by default even
#   when a key is present: unlike the asset signal, this spends a real
#   rate-limited API call on every alert with a domain IOC, on top of
#   whatever enrichment already spends checking that same domain's
#   reputation.
SENTINELOS_CORRELATION_IDENTITY_DNS_ENABLED=false

# Semantic correlation (see ingestion/semantic_correlation.py) — a third,
# opt-in tier that spends one real LLM call to judge whether an alert
# belongs to the same campaign as an open incident despite sharing no
# IOC, subnet, or domain family at all (e.g. the same attack technique
# against a completely different host). Off by default: unlike the free
# exact/fuzzy tiers, this one costs tokens and carries real judgment-call
# risk. It only ever runs for an alert that already passed
# SENTINELOS_INGEST_MIN_SEVERITY (i.e. one about to spend a full,
# far more expensive pipeline run anyway) — a match replaces that cost,
# it never adds a new one to routine noise that would've been suppressed.
SENTINELOS_CORRELATION_SEMANTIC_ENABLED=false
# How many of the most-recently-updated open incidents to show the judge
# per check — bounds prompt size/cost regardless of how many are open.
SENTINELOS_CORRELATION_SEMANTIC_MAX_CANDIDATES=5
# Minimum confidence (low/medium/high) the judge must report before a
# semantic match is trusted; anything below is treated as no match.
SENTINELOS_CORRELATION_SEMANTIC_MIN_CONFIDENCE=medium

# Optional — threat-intel enrichment (see enrichment/). Without these,
# Triage still runs, just without verified IOC reputation data; the
# ATT&CK technique validation (enrichment/mitre_attack.py) needs no key
# at all, since it's a local curated dataset, not a live API.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Shodan exposed-service enrichment (see enrichment/providers.py) — needs
# NO API key at all, since it uses Shodan's free InternetDB endpoint
# (https://internetdb.shodan.io). It's gated by this flag instead of a
# key: querying a third party with an IP you're actively investigating is
# a real operational-security choice (it tells Shodan which IPs this
# deployment cares about), so it defaults to off rather than making that
# call silently just because it happens to be free. When enabled, every
# "ip" IOC also gets checked for exposed ports/hostnames/known CVEs.
SENTINELOS_SHODAN_ENABLED=false

# Alerting (see notifications/) — opt-in: unset, nothing is ever sent.
# Set to any URL that accepts a JSON POST and this fires a webhook
# notification whenever an incident reaches pending_approval (a human
# needs to act now) or its severity is at/above SENTINELOS_ALERT_MIN_SEVERITY
# (default "high"), regardless of status. Works natively with Slack,
# Discord, and Microsoft Teams incoming webhooks (they all render the
# payload's "text" field), PagerDuty's Events API, or your own relay —
# no vendor is hardcoded.
SENTINELOS_ALERT_WEBHOOK_URL=
SENTINELOS_ALERT_MIN_SEVERITY=high

# Optional — signs every outbound webhook POST with HMAC-SHA256, sent as
# the X-SentinelOS-Signature header ("sha256=<hex>", the same shape
# GitHub/Stripe/Slack use for their own outbound webhooks). Without this,
# anyone who obtains the webhook URL can send your receiver a convincing
# fake notification and it has no way to tell. Additive — a receiver that
# doesn't check the header is unaffected either way.
SENTINELOS_WEBHOOK_SIGNING_SECRET=

# Optional — included as a clickable link in every notification payload
# if set (e.g. https://sentinelos.internal.example.com). Omit it and
# notifications still work, just without a direct link back.
SENTINELOS_DASHBOARD_BASE_URL=

# Rotation for the append-only JSONL logs (data/{tenant}/ingestion_log.jsonl,
# data/auth_failures.jsonl, data/{tenant}/audit_chain_ledger.jsonl) — all
# three grow forever without this. Rotates the active file to .1, a
# prior .1 to .2, etc. once it reaches SENTINELOS_LOG_MAX_BYTES, keeping
# at most SENTINELOS_LOG_BACKUP_COUNT old copies. Set MAX_BYTES to 0 to
# disable rotation entirely (unbounded growth); set BACKUP_COUNT to 0 to
# truncate instead of keeping any history.
SENTINELOS_LOG_MAX_BYTES=10485760
SENTINELOS_LOG_BACKUP_COUNT=3
